<Window x:Class="lab08p01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab08p01"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock 
            x:Name="textBlock1"
            Grid.Column="0" 
            Grid.Row="0"
            Grid.ColumnSpan="3"
            Margin="10px"
            Padding="10px"
            TextWrapping="Wrap"
            TextTrimming="WordEllipsis"
         />
       <Button
           x:Name="btn_fonty"
            Grid.Column="0" 
            Grid.Row="2"
            Margin="10px"
            Padding="10px"
            Content="Fonty" Click="btn_fonty_Click"
         />
        <Button
     x:Name="btn_kol_fontow"
      Grid.Column="1" 
      Grid.Row="2"
      Margin="10px"
      Padding="10px"
      Content="Kolor fontów" Click="btn_kol_fontow_Click" 
   />
        <Button
     x:Name="btn_kol_tla"
      Grid.Column="2" 
      Grid.Row="2"
      Margin="10px"
      Padding="10px"
      Content="Kolor tla" Click="btn_kol_tla_Click" 
       
   />
        
        <Slider
            x:Name="slider1"
            Grid.Column="0" 
            Grid.Row="1"
            Grid.ColumnSpan="3"
            Margin="10px"
            Padding="10px"
            Minimum="8" 
            Maximum="72" 
            VerticalAlignment="Center" 
            ValueChanged="slider1_ValueChanged"
         />
    </Grid>
</Window>
